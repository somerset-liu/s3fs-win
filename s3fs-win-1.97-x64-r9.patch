+//-------------------------------------------------------------------
+// sysconf()/pwd/grp: Windows has no /etc/passwd, so the identity of the
+// caller is reported as the numeric id and the group is empty.
+//-------------------------------------------------------------------
+#define _SC_GETPW_R_SIZE_MAX    1
+#define _SC_GETGR_R_SIZE_MAX    2
+
+inline long sysconf(int name)
+{
+    (void)name;
+    return 1024;
+}
+
+struct passwd {
+    char*   pw_name;
+    char*   pw_passwd;
+    uid_t   pw_uid;
+    gid_t   pw_gid;
+    char*   pw_gecos;
+    char*   pw_dir;
+    char*   pw_shell;
+};
+
+struct group {
+    char*   gr_name;
+    char*   gr_passwd;
+    gid_t   gr_gid;
+    char**  gr_mem;
+};
+
+inline struct passwd* getpwuid(uid_t uid)
+{
+    static struct passwd  pw;
+    static char           name[32];
+    static char*          members[1] = { nullptr };
+
+    (void)members;
+    snprintf(name, sizeof(name), "u%u", static_cast<unsigned int>(uid));
+    pw.pw_name   = name;
+    pw.pw_passwd = const_cast<char*>("*");
+    pw.pw_uid    = uid;
+    pw.pw_gid    = 0;
+    pw.pw_gecos  = name;
+    pw.pw_dir    = const_cast<char*>("");
+    pw.pw_shell  = const_cast<char*>("");
+
+    return &pw;
+}
+
+inline int getpwuid_r(uid_t uid, struct passwd* pwd, char* buf, size_t buflen, struct passwd** res)
+{
+    if(nullptr == pwd || nullptr == buf || nullptr == res){
+        return EINVAL;
+    }
+    if(buflen < 32){
+        return ERANGE;
+    }
+    *res = nullptr;
+    snprintf(buf, buflen, "u%u", static_cast<unsigned int>(uid));
+    *pwd         = {};
+    pwd->pw_name = buf;
+    pwd->pw_dir  = const_cast<char*>("");
+    pwd->pw_uid  = uid;
+
+    *res = pwd;
+    return 0;
+}
+
+inline int getgrgid_r(gid_t gid, struct group* grp, char* buf, size_t buflen, struct group** res)
+{
+    static char* nomem[1] = { nullptr };
+
+    if(nullptr == grp || nullptr == buf || nullptr == res){
+        return EINVAL;
+    }
+    if(buflen < 32){
+        return ERANGE;
+    }
+    *res = nullptr;
+    snprintf(buf, buflen, "g%u", static_cast<unsigned int>(gid));
+    *grp         = {};
+    grp->gr_name = buf;
+    grp->gr_gid  = gid;
+    grp->gr_mem  = nomem;
+
+    *res = grp;
+    return 0;
+}
+
+inline uid_t getuid(void)  { return 0; }
+inline uid_t geteuid(void) { return 0; }
+inline gid_t getgid(void)  { return 0; }
+inline gid_t getegid(void) { return 0; }
