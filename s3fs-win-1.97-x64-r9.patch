+#ifndef S3FS_WIN_SYSLOG_H_
+#define S3FS_WIN_SYSLOG_H_
+
+//
+// A <syslog.h> for the Windows(mingw-w64) build.
+//
+// There is no syslog daemon on Windows, so the calls are stubbed out: s3fs
+// keeps writing its log to the console and to the file given by -o logfile,
+// which is the only thing that works in a WinFsp session anyway.  The level
+// constants are the ones from the Single UNIX Specification, they are only
+// compared with each other here.
+//
+// This header is included instead of <syslog.h> when building with __MSYS__
+// (see s3fs_logger.h), so the POSIX builds do not see it at all.
+//
+
+#define LOG_EMERG       0       /* system is unusable */
+#define LOG_ALERT       1       /* action must be taken immediately */
+#define LOG_CRIT        2       /* critical conditions */
+#define LOG_ERR         3       /* error conditions */
+#define LOG_WARNING     4       /* warning conditions */
+#define LOG_NOTICE      5       /* normal but significant condition */
+#define LOG_INFO        6       /* informational */
+#define LOG_DEBUG       7       /* debug-level messages */
+
+#define LOG_PID         0x01    /* log the process id with each message */
+#define LOG_ODELAY      0x04    /* delay open until first syslog() */
+#define LOG_NOWAIT      0x20    /* don't wait for child processes */
+
+#define LOG_USER        1       /* random user-level messages */
+
+#define LOG_UPTO(p)     (p)     /* setlogmask() is a no-op, so the mask is the level */
+
+inline void openlog(const char* /*ident*/, int /*option*/, int /*facility*/) {}
+inline void closelog() {}
+inline int  setlogmask(int /*mask*/) { return 0; }
+inline void syslog(int /*priority*/, const char* /*fmt*/, ...) {}
+
+#endif // S3FS_WIN_SYSLOG_H_
