new file mode 100644
index 0000000..a12d91d
--- /dev/null
+++ b/src/test_tmpfile.cpp
@@ -0,0 +1,220 @@
+/*
+ * s3fs - FUSE-based file system backed by Amazon S3
+ *
+ * Copyright(C) 2007 Takeshi Nakatani <ggtakec.com>
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
+ */
+
+//
+// Tests the temporary file FdManager::MakeTempFile() builds: a file that is
+// already unlinked, so that its name is gone once the descriptor is closed
+// while reads and writes keep working until then.
+//
+// The Windows CRT cannot unlink a file that is still open, which is why it
+// needs its own way of getting there(see s3fs_tempfile_unlinked() in
+// win_posix.h).  Both sides of that #ifdef are checked here: run this test
+// natively and, for the Windows target, under wine.
+//
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cerrno>
+#include <string>
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "win_posix.h"      // s3fs_tempfile_unlinked() on Windows, empty elsewhere
+
+#define TMPFILE_TEMPLATE    "./s3fststXXXXXX"
+#define TMPFILE_PREFIX      "s3fstst"
+
+#define ASSERT(cond)                                                        \
+    do {                                                                    \
+        if(!(cond)){                                                        \
+            std::fprintf(stderr, "FAIL %s:%d: %s (errno=%d)\n", __FILE__, __LINE__, #cond, errno); \
+            std::fflush(stderr);                                            \
+            return 1;                                                       \
+        }                                                                   \
+    } while(0)
+
+//-------------------------------------------------------------------
+// Helpers
+//-------------------------------------------------------------------
+// The body of FdManager::MakeTempFile(), down to the descriptor: the same
+// #ifdef, so that what is tested is what the file system uses.
+static int make_unlinked_tempfile(char* tmpl)
+{
+    int fd = mkstemp(tmpl);
+    if(-1 == fd){
+        return -1;
+    }
+#ifdef __MSYS__
+    return s3fs_tempfile_unlinked(fd, tmpl);
+#else
+    if(0 != unlink(tmpl)){
+        int saved_errno = errno;
+        close(fd);
+        errno = saved_errno;
+        return -1;
+    }
+    return fd;
+#endif
+}
+
+static bool file_exists(const char* path)
+{
+    struct stat st;
+    return (0 == stat(path, &st));
+}
+
+// How many files starting with TMPFILE_PREFIX are left in the directory.
+static int count_tempfiles()
+{
+    int count = 0;
+    DIR* dp;
+    if(nullptr == (dp = opendir("."))){
+        std::fprintf(stderr, "FAIL could not open the current directory(errno=%d)\n", errno);
+        return -1;
+    }
+    for(const struct dirent* dent = readdir(dp); nullptr != dent; dent = readdir(dp)){
+        if(0 == strncmp(dent->d_name, TMPFILE_PREFIX, sizeof(TMPFILE_PREFIX) - 1)){
+            ++count;
+        }
+    }
+    closedir(dp);
+    return count;
+}
+
+//-------------------------------------------------------------------
+// Tests
+//-------------------------------------------------------------------
+// The file is created, written and read back, and its name is gone after the
+// descriptor is closed.  One round.
+static int test_one_round()
+{
+    char tmpl[] = TMPFILE_TEMPLATE;
+
+    // create
+    int fd = make_unlinked_tempfile(tmpl);
+    ASSERT(-1 != fd);
+    ASSERT('\0' != tmpl[0]);
+
+    // the name is still the one mkstemp() picked
+    std::string name = tmpl;
+    ASSERT(nullptr != strstr(name.c_str(), TMPFILE_PREFIX));
+
+    // write and read back through stdio, the way FdEntity does
+    FILE* fp = fdopen(fd, "rb+");
+    ASSERT(nullptr != fp);
+    ASSERT(11 == fwrite("0123456789A", 1, 11, fp));
+    ASSERT(0 == fflush(fp));
+
+    struct stat st;
+    ASSERT(0 == fstat(fileno(fp), &st));
+    ASSERT(11 == static_cast<long long>(st.st_size));
+
+    // ... and through pread()/pwrite(), the way FdEntity::Read()/Write() do
+    char    buf[16] = {};
+    ASSERT(3 == pwrite(fileno(fp), "XYZ", 3, 0));
+    ASSERT(3 == pread(fileno(fp), buf, 3, 0));
+    ASSERT(0 == memcmp(buf, "XYZ", 3));
+
+    // truncate and fsync, the way FdEntity::Open() does
+    ASSERT(0 == ftruncate(fileno(fp), 20));
+    ASSERT(0 == fsync(fileno(fp)));
+    ASSERT(0 == fstat(fileno(fp), &st));
+    ASSERT(20 == static_cast<long long>(st.st_size));
+
+    // s3fs hands the descriptor to a second reader with dup()(FdEntity::Dup,
+    // curl.cpp); the file must outlive the first descriptor, not be deleted by
+    // closing it.
+    int dupfd = dup(fileno(fp));
+    ASSERT(-1 != dupfd);
+    ASSERT(3 == pread(dupfd, buf, 3, 0));
+    ASSERT(0 == memcmp(buf, "XYZ", 3));
+
+    fclose(fp);
+#ifdef __MSYS__
+    // On Windows the name is only removed with the last descriptor.
+    ASSERT(file_exists(name.c_str()));
+#endif
+    ASSERT(-1 != close(dupfd));
+
+    // closed -> the name is gone on both platforms
+    ASSERT(!file_exists(name.c_str()));
+
+    return 0;
+}
+
+// Nothing accumulates: creating and closing several of them leaves no leftover.
+static int test_no_leftovers()
+{
+    int before = count_tempfiles();
+    if(0 > before){
+        return 1;
+    }
+    for(int count = 0; count < 3; ++count){
+        char tmpl[] = TMPFILE_TEMPLATE;
+        int  fd     = make_unlinked_tempfile(tmpl);
+        if(-1 == fd){
+            return 1;
+        }
+        if(0 != close(fd)){
+            return 1;
+        }
+    }
+    return (before == count_tempfiles() ? 0 : 1);
+}
+
+// A template whose directory does not exist must fail, not crash.
+static int test_failure()
+{
+    char tmpl[] = "./no/such/dir/s3fststXXXXXX";
+    int  fd     = mkstemp(tmpl);
+    if(-1 != fd){
+        close(fd);
+        unlink(tmpl);
+        return 1;
+    }
+    return 0;
+}
+
+int main()
+{
+    int result = 0;
+    result |= test_one_round();
+    result |= test_no_leftovers();
+    result |= test_failure();
+    if(0 != result){
+        std::fprintf(stderr, "FAIL test_tmpfile(see the assertion above)\n");
+        return 1;
+    }
+    std::fprintf(stderr, "PASS test_tmpfile\n");
+    return 0;
+}
+
