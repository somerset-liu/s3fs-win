+#ifdef __MSYS__
+//
+// Removes the temporary files a previous run left in tmp_dir.
+//
+// A temporary file is opened with _O_TEMPORARY(see s3fs_tempfile_unlinked()),
+// so Windows deletes it as soon as the last descriptor closes - even when the
+// process is killed.  Only a power failure, or an older build that could not
+// delete the file at all, leaves any behind, and those would pile up.
+//
+// [NOTE]
+// The result of unlink() is ignored on purpose: a file still held by another
+// running s3fs is in the Windows "delete pending" state and cannot be removed
+// here, which is not an error for us.
+//
+static void DeleteStaleTempFiles(const std::string& dir)
+{
+    static constexpr char TMPFILE_PREFIX[] = "s3fstmp.";
+
+    if(dir.empty()){
+        return;
+    }
+    DIR* dp;
+    if(nullptr == (dp = opendir(dir.c_str()))){
+        return;
+    }
+    for(const struct dirent* dent = readdir(dp); nullptr != dent; dent = readdir(dp)){
+        if(0 == strncmp(dent->d_name, TMPFILE_PREFIX, sizeof(TMPFILE_PREFIX) - 1)){
+            std::string fullpath = dir + "/" + dent->d_name;
+            if(0 == unlink(fullpath.c_str())){
+                S3FS_PRN_INFO("removed stale temporary file(%s).", fullpath.c_str());
+            }
+        }
+    }
+    closedir(dp);
+}
+#endif  // __MSYS__
