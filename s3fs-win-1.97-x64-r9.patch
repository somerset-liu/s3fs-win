+    #define WTF8_ENCODE(ARG)  \
+            std::string ARG##_buf; \
+            const char * ARG = _##ARG; \
+            if (use_wtf8 && s3fs_wtf8_encode( _##ARG, 0 )) { \
+                s3fs_wtf8_encode( _##ARG, &ARG##_buf); \
+                ARG = ARG##_buf.c_str(); \
+            }
+
+    // No normalisation on the other platforms: the path is used as it is.
+    #define FUSE_PATH_NORMALIZE(ARG)  \
+            const char * ARG = _##ARG;
+#endif
 
 //-------------------------------------------------------------------
 // Utilities
