+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
+ */
+
+#ifndef WIN_READDIR_H_
+#define WIN_READDIR_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <sys/stat.h>
+
+//
+// Helpers for the readdir callbacks of the Windows(WinFsp) build.
+//
+// They are compiled on every platform - like fuse_path_normalize() in
+// string_util.h - so that they can be unit tested with the Linux test
+// binaries.  Only their call sites in s3fs.cpp and s3fs_threadreqs.cpp are
+// inside #ifdef __MSYS__, so the Linux callbacks keep the upstream behaviour.
+//
+
+//-------------------------------------------------------------------
+// class DirHandleMap
+//-------------------------------------------------------------------
+//
+// Maps a directory handle(the fi->fh a FUSE callback gets) to the path that
+// opendir() was called with.
+//
+// WinFsp identifies an open directory by its file handle and hands readdir()
+// an empty path, while the Linux kernel always repeats the path.  s3fs has no
+// directory handle of its own, so without this table an empty path can only be
+// answered with ESTALE, which WinFsp reads as "end of directory": the mount
+// point opens but lists nothing.
+//
+// The table - and not a string malloc'ed into fi->fh - is used on purpose:
+// WinFsp is not required to call releasedir(), so an allocation handed to
+// fi->fh could leak, and a freed one could be read back by a late readdir().
+// A bounded table leaks neither and a stale handle simply misses.
+//
+class DirHandleMap
+{
+    public:
+        // Upper bound on the remembered paths.  If releasedir() is never
+        // called, the oldest handle is dropped once the table is full, so the
+        // memory stays bounded without any cooperation from the caller.
+        static constexpr std::size_t MaxEntries = 4096;
+
+        static DirHandleMap& Get()
+        {
+            static DirHandleMap singleton;
+            return singleton;
+        }
+
+        // Remember path and return the handle to store in fi->fh.  The handle
+        // is never 0, because 0 is what an untouched fi->fh holds.
+        std::uint64_t Store(const std::string& path)
+        {
+            const std::lock_guard<std::mutex> lock(handle_lock);
+
+            std::uint64_t handle = next_handle++;
+            if(0 == handle){          // only after wrapping around
+                handle = next_handle++;
+            }
+            while(MaxEntries <= path_map.size()){
+                path_map.erase(path_map.begin());     // std::map is ordered by handle
+            }
+            path_map.emplace(handle, path);
+            return handle;
+        }
+
+        // Copy the path of handle into path.  Returns false when the handle is
+        // 0, unknown or already forgotten.
+        bool Find(std::uint64_t handle, std::string& path) const
+        {
+            if(0 == handle){
+                return false;
+            }
+            const std::lock_guard<std::mutex> lock(handle_lock);
+
+            auto iter = path_map.find(handle);
+            if(path_map.cend() == iter){
+                return false;
+            }
+            path = iter->second;
+            return true;
+        }
+
+        // Forget handle.  Returns false when there was nothing to forget,
+        // which is the normal outcome on a platform without opendir() or after
+        // the entry was dropped to keep the table bounded.
+        bool Erase(std::uint64_t handle)
+        {
+            if(0 == handle){
+                return false;
+            }
+            const std::lock_guard<std::mutex> lock(handle_lock);
+
+            return 0 != path_map.erase(handle);
+        }
+
+        std::size_t Count() const
+        {
+            const std::lock_guard<std::mutex> lock(handle_lock);
+            return path_map.size();
+        }
+
+        // Only for the unit tests.
+        void Clear()
+        {
+            const std::lock_guard<std::mutex> lock(handle_lock);
+            path_map.clear();
+        }
+
+    private:
+        DirHandleMap() = default;
+        ~DirHandleMap() = default;
+        DirHandleMap(const DirHandleMap&)            = delete;
+        DirHandleMap(DirHandleMap&&)                 = delete;
+        DirHandleMap& operator=(const DirHandleMap&) = delete;
+        DirHandleMap& operator=(DirHandleMap&&)      = delete;
+
+        mutable std::mutex                     handle_lock;
+        std::map<std::uint64_t, std::string>   path_map;
+        std::uint64_t                          next_handle = 1;
+};
+
+//
+// The path a readdir() callback has to list.
+//
+// It is the path FUSE passed, or, when FUSE passed none, the one opendir()
+// stored under handle.  An empty return value means neither was available and
+// the caller answers ESTALE, as upstream does.
+//
+inline std::string resolve_dir_path(const char* path, std::uint64_t handle)
+{
+    if(path && '\0' != path[0]){
+        return path;
+    }
+
+    std::string stored;
+    if(0 != handle && DirHandleMap::Get().Find(handle, stored)){
+        return stored;
+    }
+    return std::string();
+}
+
+//
+// The stat to list an entry with when its HEAD request did not answer.
+//
+// Upstream leaves such an entry out of the listing, which is right for a
+// missing object but wrong for a request that merely failed: an empty listing
+// is worse than an entry whose size and timestamp are placeholders.
+//
+inline struct stat make_fallback_stat(bool is_dir)
+{
+    struct stat st = {};
+
+    st.st_mode  = (is_dir ? S_IFDIR : S_IFREG) |
+                  (is_dir ? (S_IRWXU | S_IRWXG | S_IRWXO)
+                          : (S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP | S_IROTH | S_IWOTH));
+    st.st_nlink = 1;
+    st.st_size  = 0;        // unknown: the object was not asked about successfully
+    return st;
+}
+
+#endif // WIN_READDIR_H_
