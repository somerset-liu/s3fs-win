+//-------------------------------------------------------------------
+// sigaction(): the CRT only has signal(), and s3fs uses sigaction() for
+// SIGUSR1/SIGUSR2(reload / rotate) and SIGHUP(rotate) which it raises itself.
+//-------------------------------------------------------------------
+#ifndef SIGHUP
+#define SIGHUP      1
+#endif
+#ifndef SIGUSR1
+#define SIGUSR1     30
+#endif
+#ifndef SIGUSR2
+#define SIGUSR2     31
+#endif
+#define SA_RESTART  0x1
+
+struct sigaction {
+    void (*sa_handler)(int);
+    int  sa_flags;
+};
+
+inline int sigaction(int sig, const struct sigaction* act, struct sigaction* oldact)
+{
+    (void)oldact;
+    if(!act){
+        return -1;
+    }
+    return (SIG_ERR == signal(sig, act->sa_handler)) ? -1 : 0;
+}
+
+//-------------------------------------------------------------------
+// The POSIX regex(<regex.h>) that addhead.cpp uses for -o add_head, mapped
+// onto std::regex.  Only the extended, no-subexpression form is needed.
+//-------------------------------------------------------------------
+struct regex_t {
+    std::regex  re;
+    bool        is_valid = false;
+};
+
+struct regmatch_t {
+    long long   rm_so;
+    long long   rm_eo;
+};
+
+#define REG_EXTENDED    0x1
+#define REG_NOSUB       0x2
+#define REG_NOTBOL      0x4
+#define REG_NOTEOL      0x8
+
+#define REG_NOMATCH     1
+#define REG_BADPAT      2
+
+inline int regcomp(regex_t* preg, const char* pattern, int cflags)
+{
+    (void)cflags;
+#if defined(__cpp_exceptions) || defined(__EXCEPTIONS) || defined(_CPPUNWIND)
+    try{
+        preg->re.assign(pattern, std::regex::extended | std::regex::nosubs);
+    }catch(...){
+        return REG_BADPAT;
+    }
+#else
+    // [NOTE]
+    // Built with -fno-exceptions: std::regex() cannot report a bad pattern, so
+    // an invalid -o add_head regex aborts instead of printing an error.  The
+    // Windows build passes -fexceptions(see the BUILD notes) to avoid this.
+    preg->re.assign(pattern, std::regex::extended | std::regex::nosubs);
+#endif
+    preg->is_valid = true;
+
+    return 0;
+}
+
+inline int regexec(const regex_t* preg, const char* string, size_t nmatch, regmatch_t pmatch[], int eflags)
+{
+    (void)eflags;
+
+    if(!preg || !preg->is_valid || !string){
+        return REG_NOMATCH;
+    }
+    std::cmatch m;
+    if(!std::regex_search(string, m, preg->re)){
+        return REG_NOMATCH;
+    }
+    if(nmatch && pmatch){
+        pmatch[0].rm_so = static_cast<long long>(m.position(0));
+        pmatch[0].rm_eo = static_cast<long long>(m.length(0) + m.position(0));
+    }
+    return 0;
+}
+
+inline void regfree(regex_t* preg)
+{
+    if(preg){
+        preg->re = std::regex();
+        preg->is_valid = false;
+    }
+}
+
+inline size_t regerror(int errcode, const regex_t* preg, char* errbuf, size_t errbuf_size)
+{
+    (void)preg;
+    const char* msg = (REG_NOMATCH == errcode) ? "regex did not match" : "regex error";
+    size_t      len = strlen(msg) + 1;
+
+    if(errbuf && 0 != errbuf_size){
+        snprintf(errbuf, errbuf_size, "%s", msg);
+    }
+    return len;
+}
+
+#endif  // __MSYS__
+
+#endif  // S3FS_WIN_POSIX_H_
