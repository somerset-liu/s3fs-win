+// [NOTE]
+// fuse_path_normalize() only changes what the Windows(WinFsp) build receives,
+// but it is compiled on every platform, so the Linux paths are checked here as
+// well: they must come back unchanged.
+static void test_path_normalize()
+{
+    // the spellings of the mount point all become "/"
+    ASSERT_EQUALS("/"s, fuse_path_normalize(nullptr));
+    ASSERT_EQUALS("/"s, fuse_path_normalize(""));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("."));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("/"));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("\\"));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("./"));
+    ASSERT_EQUALS("/"s, fuse_path_normalize(".\\"));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("/."));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("\\."));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("//"));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("\\\\"));
+    ASSERT_EQUALS("/"s, fuse_path_normalize("/./"));
+
+    // a Windows style path becomes the "/" separated one the FUSE layer wants
+    ASSERT_EQUALS("/autorun.inf"s, fuse_path_normalize("\\autorun.inf"));
+    ASSERT_EQUALS("/dir/autorun.inf"s, fuse_path_normalize("\\dir\\autorun.inf"));
+    ASSERT_EQUALS("/dir/autorun.inf"s, fuse_path_normalize("/dir/autorun.inf"));
+
+    // repeated separators are collapsed, a missing leading one is added
+    ASSERT_EQUALS("/a/b"s, fuse_path_normalize("/a//b"));
+    ASSERT_EQUALS("/a/b"s, fuse_path_normalize("\\a\\\\b"));
+    ASSERT_EQUALS("/a/b"s, fuse_path_normalize("a/b"));
+    ASSERT_EQUALS("/a/b/"s, fuse_path_normalize("/a/b//"));
+    ASSERT_EQUALS("/a/b/"s, fuse_path_normalize("/a/b/"));
+
+    // A relative name gets the leading separator the FUSE contract asks for:
+    // WinFsp may hand over "desktop.ini" where the Linux kernel sends
+    // "/desktop.ini", and without the separator s3fs would ask the server for
+    // a different object than the one it just listed.
+    ASSERT_EQUALS("/desktop.ini"s, fuse_path_normalize("desktop.ini"));
+    ASSERT_EQUALS("/desktop.ini"s, fuse_path_normalize("\\desktop.ini"));
+    ASSERT_EQUALS("/dir/desktop.ini"s, fuse_path_normalize("dir/desktop.ini"));
+    ASSERT_EQUALS("/dir/新IP.xlsx"s, fuse_path_normalize("dir/新IP.xlsx"));
+    ASSERT_EQUALS("/dir/新IP.xlsx"s, fuse_path_normalize("\\dir\\新IP.xlsx"));
+
+    // "." at the end of a directory is that directory, ".." is a real name
+    ASSERT_EQUALS("/dir"s, fuse_path_normalize("/dir/."));
+    ASSERT_EQUALS("/dir"s, fuse_path_normalize("\\dir\\."));
+    ASSERT_EQUALS("/dir/.."s, fuse_path_normalize("/dir/.."));
+    ASSERT_EQUALS("/.."s, fuse_path_normalize(".."));
+
+    // the paths a Linux kernel hands over are unchanged
+    ASSERT_EQUALS("/"s,                  fuse_path_normalize("/"));
+    ASSERT_EQUALS("/file.txt"s,          fuse_path_normalize("/file.txt"));
+    ASSERT_EQUALS("/dir/sub/file.txt"s,  fuse_path_normalize("/dir/sub/file.txt"));
+    ASSERT_EQUALS("/dir with space/f"s,  fuse_path_normalize("/dir with space/f"));
+    ASSERT_EQUALS("/a/b/../c"s,          fuse_path_normalize("/a/b/../c"));
+    ASSERT_EQUALS("/dir/"s,              fuse_path_normalize("/dir/"));
+    ASSERT_EQUALS("/" + "\xe3\x83\x86\xe3\x82\xb9\xe3\x83\x88"s, fuse_path_normalize("/\xe3\x83\x86\xe3\x82\xb9\xe3\x83\x88"));  // "/test" in Japanese
+
+    // normalizing twice changes nothing more
+    for(const char* path : {"", ".", "/", "\\", "/a//b", "\\dir\\autorun.inf", "/dir/.", "..", "/dir/sub/file.txt"}) {
+        std::string once = fuse_path_normalize(path);
+        ASSERT_EQUALS(once, fuse_path_normalize(once.c_str()));
+    }
+}
+
+// [NOTE]
+// fuse_request_path_normalize() is what get_realpath() in s3fs_util.cpp puts in
+// front of every object key of every request the Windows build sends, so these
+// are the values that actually reach the server.  It is fuse_path_normalize()
+// plus one exception, and that exception is the point of the first block: the
+// request "HEAD //" is how upstream asks for the object named "/" at the bucket
+// root, and collapsing it would ask for a different object.
+static void test_request_path_normalize()
+{
+    // the bucket root spelling survives
+    ASSERT_EQUALS("//"s,          fuse_request_path_normalize("//"));
+    ASSERT_EQUALS("/"s,           fuse_request_path_normalize("/"));
+    ASSERT_EQUALS("/"s,           fuse_request_path_normalize(""));
+    ASSERT_EQUALS("/"s,           fuse_request_path_normalize(nullptr));
+
+    // everything else is fuse_path_normalize()
+    ASSERT_EQUALS("/server.csv"s, fuse_request_path_normalize("/server.csv"));
+    ASSERT_EQUALS("/server.csv"s, fuse_request_path_normalize("\\server.csv"));
+    ASSERT_EQUALS("/dir"s,        fuse_request_path_normalize("/dir/."));
+    ASSERT_EQUALS("/dir"s,        fuse_request_path_normalize("\\dir\\."));
+    ASSERT_EQUALS("/dir/"s,       fuse_request_path_normalize("/dir/"));
+    ASSERT_EQUALS("/新IP.xlsx"s,  fuse_request_path_normalize("\\新IP.xlsx"));
+
+    // only the exact two slash spelling is kept: "//dir" is a doubled
+    // separator, not the bucket root, and still collapses
+    ASSERT_EQUALS("/dir"s,        fuse_request_path_normalize("//dir"));
+    ASSERT_EQUALS("/dir"s,        fuse_request_path_normalize("///dir"));
+
+    // the paths a Linux kernel hands over are unchanged
+    ASSERT_EQUALS("/dir/sub/file.txt"s, fuse_request_path_normalize("/dir/sub/file.txt"));
+}
+
+// [NOTE]
+// posix_dirname()/posix_basename() replace the C library dirname()/basename()
+// for the paths s3fs handles itself.  The two C library implementations are the
+// reason they exist: on Windows dirname("/server.csv") answers "\" where glibc
+// answers "/", and basename("/") answers "\" where glibc answers "/".
+// The loop at the bottom compares against the C library itself, which is only
+// meaningful where the C library is the POSIX one.
+static void test_path_components()
+{
+    // the spellings a Windows build used to hand to the server
+    ASSERT_EQUALS("/"s,  posix_dirname("/server.csv"));
+    ASSERT_EQUALS("/"s,  posix_dirname("/"));
+    ASSERT_EQUALS("/"s,  posix_dirname("//"));
+    ASSERT_EQUALS("/"s,  posix_dirname("///"));
+    ASSERT_EQUALS("/"s,  posix_dirname("/dir/"));
+    ASSERT_EQUALS("/"s,  posix_dirname("/harbor-deploy/"));
+    ASSERT_EQUALS("/dir"s, posix_dirname("/dir/f"));
+    ASSERT_EQUALS("/dir"s, posix_dirname("/dir/."));
+    ASSERT_EQUALS("/dir"s, posix_dirname("/dir/.."));
+    ASSERT_EQUALS("/a/b"s, posix_dirname("/a/b/c"));
+    ASSERT_EQUALS("."s,    posix_dirname("file"));
+    ASSERT_EQUALS("."s,    posix_dirname("."));
+    ASSERT_EQUALS("."s,    posix_dirname(".."));
+    ASSERT_EQUALS("."s,    posix_dirname(""));
+    ASSERT_EQUALS("/"s,    posix_dirname("/新IP.xlsx"));
+
+    // a local Windows cache path keeps the parent the MSVCRT one gave
+    ASSERT_EQUALS("C:\\cache\\file1/dir"s, posix_dirname("C:\\cache\\file1/dir/f"));
+    ASSERT_EQUALS("C:\\cache\\file1"s,     posix_dirname("C:\\cache\\file1/dir"));
+    ASSERT_EQUALS("\\dir"s,                posix_dirname("\\dir\\f"));
+
+    ASSERT_EQUALS("server.csv"s, posix_basename("/server.csv"));
+    ASSERT_EQUALS("/"s,          posix_basename("/"));
+    ASSERT_EQUALS("/"s,          posix_basename("//"));
+    ASSERT_EQUALS("harbor-deploy"s, posix_basename("/harbor-deploy/"));
+    ASSERT_EQUALS("f"s,          posix_basename("/dir/f"));
+    ASSERT_EQUALS("f"s,          posix_basename("C:\\cache\\file1/dir/f"));
+    ASSERT_EQUALS("f"s,          posix_basename("\\dir\\f"));
+    ASSERT_EQUALS("新IP.xlsx"s,  posix_basename("/dir/新IP.xlsx"));
+    ASSERT_EQUALS(".."s,         posix_basename("/dir/.."));
+    ASSERT_EQUALS("."s,          posix_basename(""));
+
+#ifndef __MSYS__
+    // On the platform whose C library these helpers are modelled on, they must
+    // agree with it for every path that uses only "/".  A backslash is a
+    // separator here and not there, so those are not compared.
+    for(const char* path : {"", ".", "..", "/", "///", "/foo", "/foo/", "/foo//", "/foo/bar",
+                            "foo", "foo/", "a/", "/dir/.", "/dir/..", "/dir/f", "/a/b/c",
+                            "/新IP.xlsx", "/dir with space/f"}) {
+        // dirname() is allowed to edit the string it is given, so each call gets
+        // its own copy.
+        char buf_dir[512];
+        char buf_base[512];
+        strcpy(buf_dir, path);
+        strcpy(buf_base, path);
+        ASSERT_EQUALS(std::string(dirname(buf_dir)),   posix_dirname(path));
+        ASSERT_EQUALS(std::string(basename(buf_base)), posix_basename(path));
+    }
+#endif
+
+    // The divergence these helpers exist for, measured against the C library of
+    // whichever platform this binary runs on: the MSVCRT one that mingw's
+    // dirname() forwards to answers "\" to dirname("/server.csv"), glibc answers
+    // "/".  posix_dirname() answers "/" on both, which is the value
+    // check_parent_object_access() compares its parent against.
+    {
+#ifdef __MSYS__
+        const std::string libc_answer = "\\"s;
+#else
+        const std::string libc_answer = "/"s;
+#endif
+        char buf[64];
+        strcpy(buf, "/server.csv");
+        ASSERT_EQUALS(libc_answer, std::string(dirname(buf)));
+        ASSERT_EQUALS("/"s, posix_dirname("/server.csv"));
+    }
+}
+
+// [NOTE]
+// bytes_hex() is only used by a Windows log line, but it is pure and cheap, so
+// it is checked on both platforms.
+static void test_bytes_hex()
+{
+    ASSERT_EQUALS(""s,          bytes_hex(""));
+    ASSERT_EQUALS("2f"s,        bytes_hex("/"));
+    ASSERT_EQUALS("5c"s,        bytes_hex("\\"));
+    ASSERT_EQUALS("2f 78"s,     bytes_hex("/x"));
+    // One UTF-8 encoded character(three bytes), spelled out as bytes so that the
+    // compiler's execution character set cannot get between the test and it:
+    // "\xe4" in a string literal is a code point that a UTF-8 execution charset
+    // happily re-encodes into two bytes.
+    static constexpr char MULTI[] = {static_cast<char>(0xe4), static_cast<char>(0xb8), static_cast<char>(0xb2), '\0'};
+    ASSERT_EQUALS("e4 b8 b2"s,  bytes_hex(MULTI));
+}
