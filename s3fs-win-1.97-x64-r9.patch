+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
+ */
+
+#ifndef S3FS_WIN_DLFCN_H_
+#define S3FS_WIN_DLFCN_H_
+
+//
+// A <dlfcn.h> for the Windows(mingw-w64) build.
+//
+// mingw-w64 does not ship <dlfcn.h>, and s3fs only needs the four functions
+// below, for the optional external credential library(-o credlib).  They are
+// mapped onto the Win32 loader here.  This header is included instead of
+// <dlfcn.h> when building with __MSYS__(see s3fs_cred.cpp), so the POSIX
+// builds do not see it at all.
+//
+// [NOTE]
+// The "flag" argument of dlopen() and the search rules of the dynamic loader
+// are ignored: LoadLibraryA() uses the standard Windows DLL search order.
+//
+
+#include <cstdio>
+#include <windows.h>
+
+#define RTLD_LAZY   0x0000
+#define RTLD_NOW    0x0001
+
+inline void* dlopen(const char* filename, int /*flag*/)
+{
+    if(!filename){
+        return nullptr;
+    }
+    return reinterpret_cast<void*>(LoadLibraryA(filename));
+}
+
+inline void* dlsym(void* handle, const char* name)
+{
+    if(!handle || !name){
+        return nullptr;
+    }
+    return reinterpret_cast<void*>(GetProcAddress(static_cast<HMODULE>(handle), name));
+}
+
+inline int dlclose(void* handle)
+{
+    if(!handle){
+        return -1;
+    }
+    return FreeLibrary(static_cast<HMODULE>(handle)) ? 0 : -1;
+}
+
+//
+// [NOTE]
+// The reason is formatted from GetLastError() into a static buffer, which is
+// good enough for the one caller that prints it immediately afterwards.
+//
+inline const char* dlerror()
+{
+    static char szErr[128];
+
+    DWORD LastError = GetLastError();
+    if(0 == LastError){
+        return nullptr;
+    }
+    snprintf(szErr, sizeof(szErr), "GetLastError()=0x%08lx", static_cast<unsigned long>(LastError));
+    SetLastError(0);
+
+    return szErr;
+}
+
+#endif // S3FS_WIN_DLFCN_H_
