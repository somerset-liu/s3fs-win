+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
+ */
+
+//
+// Tests the readdir helpers of src/win_readdir.h: the directory handle table
+// that s3fs_opendir() fills and s3fs_readdir() reads, and the placeholder stat
+// that an entry gets when its HEAD request did not answer.
+//
+// The helpers are compiled on every platform - only their call sites are
+// inside #ifdef __MSYS__ - so this test says the same thing on both sides:
+// run it natively and, for the Windows target, under wine.
+//
+
+#include <cstdio>
+#include <cstring>
+#include <cerrno>
+#include <string>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include "win_readdir.h"
+
+#define ASSERT(cond)                                                                            \
+    do {                                                                                        \
+        if(!(cond)){                                                                            \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);               \
+            std::fflush(stderr);                                                                \
+            return 1;                                                                           \
+        }                                                                                       \
+    } while(0)
+
+// A handle of 0 means "no handle", so it must never be handed out and never
+// resolve, and a stored path must come back unchanged.
+static int test_store_find_erase()
+{
+    DirHandleMap& map = DirHandleMap::Get();
+    map.Clear();
+
+    std::uint64_t root = map.Store("/");
+    std::uint64_t dir  = map.Store("/harbor-deploy");
+
+    ASSERT(0 != root);
+    ASSERT(root != dir);
+    ASSERT(map.Count() == 2);
+
+    std::string path;
+    ASSERT(map.Find(root, path));
+    ASSERT(path == "/");
+    ASSERT(map.Find(dir, path));
+    ASSERT(path == "/harbor-deploy");
+
+    // Find copies out, so a caller can never hold on into the table.
+    path = "changed";
+    ASSERT(map.Find(dir, path));
+    ASSERT(path == "/harbor-deploy");
+
+    ASSERT(map.Erase(dir));
+    ASSERT(!map.Find(dir, path));
+    // WinFsp may call releasedir twice, or not at all: neither is an error.
+    ASSERT(!map.Erase(dir));
+    ASSERT(!map.Erase(0));
+    ASSERT(map.Erase(root));
+    ASSERT(map.Count() == 0);
+
+    // An unknown handle, and handle 0, simply miss.
+    ASSERT(!map.Find(0, path));
+    ASSERT(!map.Find(999999, path));
+
+    map.Clear();
+    return 0;
+}
+
+// WinFsp is not required to call releasedir(), so the table must stay bounded
+// without any help from the caller: the oldest handle is dropped, not the one
+// that is in use.
+static int test_bounded()
+{
+    DirHandleMap& map = DirHandleMap::Get();
+    map.Clear();
+
+    std::uint64_t first = 0;
+    std::uint64_t last  = 0;
+    for(std::size_t i = 0; i < DirHandleMap::MaxEntries + 8; ++i){
+        std::uint64_t handle = map.Store("/dir/" + std::to_string(i));
+        if(0 == i){
+            first = handle;
+        }
+        last = handle;
+    }
+    ASSERT(map.Count() == DirHandleMap::MaxEntries);
+
+    std::string path;
+    ASSERT(!map.Find(first, path));           // the oldest one made room
+    ASSERT(map.Find(last, path));             // the one in use did not
+    ASSERT(path == "/dir/" + std::to_string(DirHandleMap::MaxEntries + 7));
+    // Forgetting an already forgotten handle - the releasedir() WinFsp may or
+    // may not call - is a no-op, not an error.
+    ASSERT(!map.Erase(first));
+
+    map.Clear();
+    return 0;
+}
+
+// What s3fs_readdir() does with its arguments: keep the path FUSE passed, and
+// fall back to the handle when it passed none.
+static int test_resolve_dir_path()
+{
+    DirHandleMap& map = DirHandleMap::Get();
+    map.Clear();
+
+    const std::uint64_t root = map.Store("/");
+    const std::uint64_t dir  = map.Store("/harbor-deploy");
+
+    // The Linux kernel repeats the path: the handle is not even looked at.
+    ASSERT(resolve_dir_path("/", root) == "/");
+    ASSERT(resolve_dir_path("/harbor-deploy", 0) == "/harbor-deploy");
+
+    // WinFsp names the directory by its handle and passes no path at all.
+    // This is the case that made the mount point list nothing but "." and "..".
+    ASSERT(resolve_dir_path("", root) == "/");
+    ASSERT(resolve_dir_path("", dir) == "/harbor-deploy");
+    ASSERT(resolve_dir_path(nullptr, dir) == "/harbor-deploy");
+
+    // The Windows spellings of the root are not empty, so they come back as
+    // they went in: turning "\" or "." into "/" is fuse_path_normalize()'s
+    // job, which the callback runs over whatever this function returned(see
+    // test_path_normalize in test_string_util.cpp for that half).
+    ASSERT(resolve_dir_path("\\", root) == "\\");
+    ASSERT(resolve_dir_path(".", root) == ".");
+
+    // Nothing to recover from: the caller answers ESTALE, as upstream does.
+    ASSERT(resolve_dir_path("", 0).empty());
+    ASSERT(resolve_dir_path(nullptr, 0).empty());
+    ASSERT(resolve_dir_path("", 999999).empty());
+    ASSERT(resolve_dir_path(nullptr, 999999).empty());
+    ASSERT(resolve_dir_path(nullptr, 0).empty());
+
+    // After releasedir() the handle is gone, and a readdir() that comes after
+    // it misses instead of listing the wrong directory.
+    ASSERT(map.Erase(dir));
+    ASSERT(resolve_dir_path("", dir).empty());
+    ASSERT(resolve_dir_path("/harbor-deploy", dir) == "/harbor-deploy");
+
+    map.Clear();
+    return 0;
+}
+
+// A full opendir/readdir/releasedir sequence, the way the callbacks use it.
+static int test_open_readdir_release()
+{
+    DirHandleMap& map = DirHandleMap::Get();
+    map.Clear();
+
+    // opendir("/harbor-deploy") stores the path and hands the handle to FUSE.
+    std::uint64_t fh = map.Store("/harbor-deploy");
+    ASSERT(0 != fh);
+
+    // Three readdir() calls on that handle - WinFsp may ask more than once -
+    // all name the same directory.
+    for(int i = 0; i < 3; ++i){
+        ASSERT(resolve_dir_path("", fh) == "/harbor-deploy");
+    }
+
+    // A second directory gets its own handle and its own path.
+    std::uint64_t other = map.Store("/");
+    ASSERT(other != fh);
+    ASSERT(resolve_dir_path("", other) == "/");
+    ASSERT(resolve_dir_path("", fh) == "/harbor-deploy");
+
+    // releasedir() forgets one without disturbing the other.
+    ASSERT(map.Erase(other));
+    ASSERT(resolve_dir_path("", other).empty());
+    ASSERT(resolve_dir_path("", fh) == "/harbor-deploy");
+
+    map.Clear();
+    return 0;
+}
+
+// The placeholder stat: a directory must still look like one, a file like a
+// file, and neither may come out as mode 0(which is no type at all).
+static int test_fallback_stat()
+{
+    struct stat dir = make_fallback_stat(true);
+    struct stat reg = make_fallback_stat(false);
+
+    ASSERT(S_ISDIR(dir.st_mode));
+    ASSERT(!S_ISREG(dir.st_mode));
+    ASSERT(S_ISREG(reg.st_mode));
+    ASSERT(!S_ISDIR(reg.st_mode));
+
+    ASSERT((dir.st_mode & 07777) != 0);
+    ASSERT((reg.st_mode & 07777) != 0);
+    ASSERT((reg.st_mode & 0111) == 0);         // a plain file is not executable
+    ASSERT((dir.st_mode & (S_IXUSR | S_IXGRP | S_IXOTH)) != 0);
+
+    ASSERT(dir.st_nlink == 1);
+    ASSERT(dir.st_size == 0);
+    return 0;
+}
+
+int main()
+{
+    int result = 0;
+    result |= test_store_find_erase();
+    result |= test_bounded();
+    result |= test_resolve_dir_path();
+    result |= test_open_readdir_release();
+    result |= test_fallback_stat();
+    if(0 != result){
+        std::fprintf(stderr, "FAIL test_dirhandle(see the assertion above)\n");
+        return 1;
+    }
+    std::fprintf(stderr, "PASS test_dirhandle\n");
+    return 0;
+}
+
