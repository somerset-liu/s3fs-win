+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
+ */
+
+#ifndef S3FS_WIN_POSIX_H_
+#define S3FS_WIN_POSIX_H_
+
+//
+// A small POSIX layer for the Windows(mingw-w64) build.
+//
+// Upstream builds s3fs for Windows in the MSYS2 *MSYS* shell, i.e. with the
+// Cygwin derived compiler, where struct stat/uid_t/regcomp() are all there and
+// WinFsp maps its fuse_* types onto them(see winfsp_fuse.h, __CYGWIN__ branch).
+// When cross compiling with mingw-w64 instead - which is how we get an s3fs.exe
+// that does not need the Cygwin runtime - three things are missing:
+//
+//   1) the POSIX types(uid_t, gid_t, blkcnt_t, ...) and the S_IFLNK/S_ISLNK
+//      macros, which the mingw-w64 headers do not declare at all;
+//   2) the POSIX functions(timegm, gmtime_r, fsync, utimensat, getpwuid_r,
+//      sigaction, regcomp, ...);
+//   3) the fuse_* structures: WinFsp hands a "struct fuse_stat" to every
+//      callback while the CRT's "struct stat" has neither st_blocks nor
+//      st_blksize, so the two are not interchangeable.
+//
+// This header supplies all three.  It is included from common.h and types.h
+// and everything in it is behind __MSYS__, so the POSIX builds are untouched.
+//
+// [NOTE]
+// It includes the CRT headers it needs before defining the aliases below, so
+// that the CRT's own declarations are not rewritten by them.  Include this
+// header before any other project header.
+//
+
+#ifdef __MSYS__
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <regex>
+#include <direct.h>
+#include <fcntl.h>
+#include <io.h>
+#include <signal.h>
+#include <share.h>              // _sopen()/_O_TEMPORARY, see s3fs_tempfile_unlinked()
+#include <dirent.h>
+#include <direct.h>             // _wmkdir(), r9
+#include <stdio.h>              // _wfopen()/_wrename(), r9
+#include <stdarg.h>             // va_list in s3fs_wopen(), r9
+#include <wchar.h>              // wcslen(), r9
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/utime.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <winfsp_fuse.h>      // struct fuse_stat / fuse_statvfs / fuse_timespec / fuse_* types
+
+//-------------------------------------------------------------------
+// POSIX types the mingw-w64 headers do not declare
+//
+// They are the WinFsp types(fuse_uid_t & friends) under the POSIX names, so
+// that a struct fuse_stat can be filled in without conversions.
+//-------------------------------------------------------------------
+typedef fuse_uid_t        uid_t;
+typedef fuse_gid_t        gid_t;
+typedef fuse_blkcnt_t     blkcnt_t;
+typedef fuse_blksize_t    blksize_t;
+typedef fuse_fsblkcnt_t   fsblkcnt_t;
+
+//-------------------------------------------------------------------
+// errno values and limits the mingw-w64 headers do not declare
+//-------------------------------------------------------------------
+#ifndef ESTALE
+#define ESTALE      116     /* "Stale NFS file handle" in the Single UNIX Spec */
+#endif
+#ifndef EREMOTE
+#define EREMOTE     121     /* "Target address is remote" in the Single UNIX Spec */
+#endif
+#ifndef NAME_MAX
+#define NAME_MAX    255
+#endif
+#ifndef PATH_MAX
+#define PATH_MAX    260     // _MAX_PATH
+#endif
+
+//
+// The wait status macros: on Windows system() returns the exit code itself
+// rather than a wait status, so everything but the -1 it returns on failure is
+// treated as "the command ran".
+//
+#ifndef WIFEXITED
+#define WIFEXITED(status)       ((status) != -1)
+#endif
+#ifndef WEXITSTATUS
+#define WEXITSTATUS(status)     (status)
+#endif
+
+//-------------------------------------------------------------------
+// File type macros the mingw-w64 headers do not declare
+//-------------------------------------------------------------------
+#ifndef S_IFMT
+#define S_IFMT    0170000
+#endif
+#ifndef S_IFLNK
+#define S_IFLNK   0120000
+#endif
+#ifndef S_IFSOCK
+#define S_IFSOCK  0140000
+#endif
+#ifndef S_ISLNK
+#define S_ISLNK(mode)   (((mode) & S_IFMT) == S_IFLNK)
+#endif
+#ifndef S_ISSOCK
+#define S_ISSOCK(mode)  (((mode) & S_IFMT) == S_IFSOCK)
+#endif
+
+//-------------------------------------------------------------------
+// The FUSE structures are WinFsp's, not the CRT's
+//
+// [NOTE]
+// "struct stat" is used for the stat buffer that every FUSE callback fills in,
+// which is the great majority of the uses in s3fs.  The handful of places that
+// stat the *local* file system(cache file, passwd file, mime file) call
+// fuse_stat()/fuse_statvfs() below, which the "stat"/"statvfs" aliases turn
+// into fuse_stat()/fuse_statvfs() as well.
+//-------------------------------------------------------------------
+typedef struct timespec s3fs_crt_timespec;      // the CRT one, before the alias
+typedef struct _stat64  s3fs_crt_stat;          // the CRT one, before the alias
+
+#define stat        fuse_stat
+#define statvfs     fuse_statvfs
+#define timespec    fuse_timespec
+#define mode_t      fuse_mode_t
+#define dev_t       fuse_dev_t
+#define lstat       fuse_lstat
+#define fstat       fuse_fstat
+#define mkdir       fuse_mkdir
+#define link        fuse_link
+#define flock       fuse_flock
+#define dirfd       fuse_dirfd
+#define fstatat     fuse_fstatat
+#define futimens    fuse_futimens
+#define utimensat   fuse_utimensat
+
+// WinFsp maps the FUSE struct stat's st_ino straight to the Windows FileId
+// (FileInfo->IndexNumber in fuse_intf.c) and does not substitute a value of
+// its own for 0.  Upstream s3fs leaves st_ino at 0, so every object would
+// report the same FileId; Explorer identifies items by (volume, FileId) and
+// its copy/paste availability check misbehaves then, while drag&drop uses
+// paths and keeps working.  Hand WinFsp a stable, non-zero hash instead.
+// A trailing separator is ignored so that "/dir" and "/dir/" (the two
+// spellings s3fs uses for the same directory object) share one FileId.
+inline fuse_ino_t win_inode_from_path(const char* path)
+{
+    fuse_ino_t h = 1469598103934665603ULL;      // FNV-1a 64 offset basis
+    if(path){
+        size_t len = strlen(path);
+        while(0 < len && '/' == path[len - 1]){
+            len--;
+        }
+        for(size_t i = 0; i < len; ++i){
+            h ^= static_cast<unsigned char>(path[i]);
+            h *= 1099511628211ULL;              // FNV-1a 64 prime
+        }
+    }
+    return 0 != h ? h : 1;                      // 0 means "no FileId"
+}
+
+//
+// mingw-w64 does not define the UTIME_NOW/UTIME_OMIT markers of <sys/stat.h>.
+// s3fs only uses them as tv_nsec markers(see filetimes.cpp), so the glibc
+// values are copied here for the Windows(mingw) build.
+//
+#ifndef UTIME_NOW
+#define UTIME_NOW     ((1L << 30) - 1)
+#endif
+#ifndef UTIME_OMIT
+#define UTIME_OMIT    ((1L << 30) - 2)
+#endif
+
+//-------------------------------------------------------------------
+// stat()/statvfs()/futimens()/utimensat() for the local file system
+//
+// [NOTE]
+// These are defined before the st_atime/st_mtime/st_ctime aliases below,
+// because they read the CRT structure, whose members are still named
+// st_atime/st_mtime/st_ctime there.
+//-------------------------------------------------------------------
+//
+// Turn a CRT stat buffer into the fuse_stat the FUSE layer expects.
+//
+inline void s3fs_fill_fuse_stat(const s3fs_crt_stat& crtst, struct fuse_stat* stbuf)
+{
+    *stbuf = {};
+    stbuf->st_mode        = crtst.st_mode;
+    stbuf->st_size        = crtst.st_size;
+    stbuf->st_nlink       = 1;
+    stbuf->st_blksize     = 512;
+    stbuf->st_blocks      = (static_cast<blkcnt_t>(crtst.st_size) + 511) / 512;
+    stbuf->st_atim.tv_sec = crtst.st_atime;
+    stbuf->st_mtim.tv_sec = crtst.st_mtime;
+    stbuf->st_ctim.tv_sec = crtst.st_ctime;
+}
+
+//
+// [r9] UTF-8 aware path helpers.
+//
+// s3fs stores object names as UTF-8, but the CRT's A functions interpret
+// them in the system ANSI code page: every non-ASCII cache file name would
+// be created with mojibake, and some ANSI code pages even break the path
+// structure because a trail byte can be '\'.  Everything that takes a path
+// below converts to UTF-16 first and calls the W function.
+//
+#ifndef CP_UTF8
+#define CP_UTF8 65001
+#endif
+extern "C" {
+// Declared by hand instead of including <windows.h>, which does not mix
+// with the hand-declared CreateHardLinkA() below.
+__declspec(dllimport) int __stdcall MultiByteToWideChar(unsigned int CodePage, unsigned long dwFlags, const char* lpMultiByteStr, int cbMultiByte, wchar_t* lpWideCharStr, int cchWideChar);
+__declspec(dllimport) int __stdcall WideCharToMultiByte(unsigned int CodePage, unsigned long dwFlags, const wchar_t* lpWideCharStr, int cchWideChar, char* lpMultiByteStr, int cbMultiByte, const char* lpDefaultChar, int* lpUsedDefaultChar);
+}
+
+inline std::wstring s3fs_utf8_to_wide(const char* utf8)
+{
+    std::wstring wstr;
+    if(utf8 && '\0' != *utf8){
+        int len = MultiByteToWideChar(CP_UTF8, 0, utf8, -1, nullptr, 0);
+        if(0 < len){
+            wstr.resize(static_cast<size_t>(len) - 1);
+            MultiByteToWideChar(CP_UTF8, 0, utf8, -1, &wstr[0], len);
+        }
+    }
+    return wstr;
+}
+
+inline std::string s3fs_wide_to_utf8(const wchar_t* wide, int wlen)
+{
+    std::string str;
+    if(wide && 0 < wlen){
+        int len = WideCharToMultiByte(CP_UTF8, 0, wide, wlen, nullptr, 0, nullptr, nullptr);
+        if(0 < len){
+            str.resize(static_cast<size_t>(len));
+            WideCharToMultiByte(CP_UTF8, 0, wide, wlen, &str[0], len, nullptr, nullptr);
+        }
+    }
+    return str;
+}
+
+inline int fuse_stat(const char* path, struct fuse_stat* stbuf)
+{
+    s3fs_crt_stat crtst = {};
+
+    int result = _wstat64(s3fs_utf8_to_wide(path).c_str(), &crtst);
+    if(0 == result){
+        s3fs_fill_fuse_stat(crtst, stbuf);
+    }
+    return result;
+}
+
+inline int fuse_fstat(int fd, struct fuse_stat* stbuf)
+{
+    s3fs_crt_stat crtst = {};
+
+    int result = _fstat64(fd, &crtst);
+    if(0 == result){
+        s3fs_fill_fuse_stat(crtst, stbuf);
+    }
+    return result;
+}
+
+//
+// [NOTE]
+// Windows has no symlinks on the cache directory, so lstat() is stat().
+//
+inline int fuse_lstat(const char* path, struct fuse_stat* stbuf)
+{
+    return fuse_stat(path, stbuf);
+}
+
+inline int fuse_mkdir(const char* path, mode_t /*mode*/)
+{
+    return _wmkdir(s3fs_utf8_to_wide(path).c_str());
+}
+
+//-------------------------------------------------------------------
+// [r9] UTF-8 aware directory listing and open/unlink/rename/fopen.
+// mingw's opendir()/readdir() and the CRT open()/unlink()/rename()/
+// fopen() are ANSI-only, and s3fs uses them on cache paths that carry
+// the object name as UTF-8.
+//-------------------------------------------------------------------
+struct s3fs_wdirent
+{
+    char d_name[1024];
+};
+
+struct s3fs_DIR
+{
+    _WDIR*         wdp;
+    s3fs_wdirent   ent;
+};
+
+inline s3fs_DIR* s3fs_wopendir(const char* path)
+{
+    std::wstring wpath = s3fs_utf8_to_wide(path);
+    if(wpath.empty()){
+        errno = ENOENT;
+        return nullptr;
+    }
+    _WDIR* wdp = _wopendir(wpath.c_str());
+    if(nullptr == wdp){
+        return nullptr;
+    }
+    s3fs_DIR* sdp = new s3fs_DIR();
+    sdp->wdp = wdp;
+    return sdp;
+}
+
+inline s3fs_wdirent* s3fs_wreaddir(s3fs_DIR* sdp)
+{
+    if(!sdp){
+        errno = EBADF;
+        return nullptr;
+    }
+    _wdirent* went = _wreaddir(sdp->wdp);
+    if(nullptr == went){
+        return nullptr;
+    }
+    std::string name = s3fs_wide_to_utf8(went->d_name, static_cast<int>(wcslen(went->d_name)));
+    if(sizeof(sdp->ent.d_name) <= name.size()){
+        name.resize(sizeof(sdp->ent.d_name) - 1);
+    }
+    memcpy(sdp->ent.d_name, name.c_str(), name.size() + 1);
+    return &sdp->ent;
+}
+
+inline int s3fs_wclosedir(s3fs_DIR* sdp)
+{
+    if(!sdp){
+        errno = EBADF;
+        return -1;
+    }
+    int result = _wclosedir(sdp->wdp);
+    delete sdp;
+    return result;
+}
+
+inline int s3fs_wopen(const char* path, int oflags, ...)
+{
+    std::wstring wpath = s3fs_utf8_to_wide(path);
+    if(wpath.empty()){
+        errno = ENOENT;
+        return -1;
+    }
+    int result;
+    if(0 != (oflags & _O_CREAT)){
+        va_list ap;
+        va_start(ap, oflags);
+        int pmode = va_arg(ap, int);
+        va_end(ap);
+        result = _wopen(wpath.c_str(), oflags, pmode);
+    }else{
+        result = _wopen(wpath.c_str(), oflags);
+    }
+    return result;
+}
+
+inline int s3fs_wunlink(const char* path)
+{
+    std::wstring wpath = s3fs_utf8_to_wide(path);
+    if(wpath.empty()){
+        errno = ENOENT;
+        return -1;
+    }
+    return _wunlink(wpath.c_str());
+}
+
+inline int s3fs_wrename(const char* oldpath, const char* newpath)
+{
+    std::wstring wold = s3fs_utf8_to_wide(oldpath);
+    std::wstring wnew = s3fs_utf8_to_wide(newpath);
+    if(wold.empty() || wnew.empty()){
+        errno = ENOENT;
+        return -1;
+    }
+    return _wrename(wold.c_str(), wnew.c_str());
+}
+
+inline FILE* s3fs_wfopen(const char* path, const char* mode)
+{
+    std::wstring wpath = s3fs_utf8_to_wide(path);
+    std::wstring wmode = s3fs_utf8_to_wide(mode);
+    if(wpath.empty() || wmode.empty()){
+        errno = ENOENT;
+        return nullptr;
+    }
+    return _wfopen(wpath.c_str(), wmode.c_str());
+}
+
+// The macros hand every s3fs call site the UTF-8 aware versions above.
+// open() is deliberately not macro-renamed: the C++ iostreams member
+// open() would be caught by it, so fdcache* call s3fs_wopen() directly.
+#define DIR         s3fs_DIR
+#define dirent      s3fs_wdirent
+#define opendir     s3fs_wopendir
+#define readdir     s3fs_wreaddir
+#define closedir    s3fs_wclosedir
+#define unlink      s3fs_wunlink
+#define rename      s3fs_wrename
+#define fopen       s3fs_wfopen
+
+//
+// CreateHardLinkA() is declared by hand: <windows.h> would bring in its DELETE
+// macro, which collides with s3fs's REQTYPE::DELETE enumerator(see curl.h).
+// The declaration matches the one in mingw-w64's winbase.h, so a later
+// <windows.h> in the same translation unit is a redeclaration, not a conflict.
+//
+extern "C" {
+__declspec(dllimport) int __stdcall CreateHardLinkA(const char* lpFileName, const char* lpExistingFileName, struct _SECURITY_ATTRIBUTES* lpSecurityAttributes);
+}
+
+inline int fuse_link(const char* oldpath, const char* newpath)
+{
+    if(CreateHardLinkA(newpath, oldpath, nullptr)){
+        return 0;
+    }
+    errno = (0 == _access(newpath, 0)) ? EEXIST : EPERM;
+    return -1;
+}
+
+//
+// [NOTE]
+// The CRT has no advisory file locking.  s3fs uses flock() only to serialise
+// its own cache file stats between processes, and a single s3fs.exe is the
+// normal Windows setup, so pretending the lock succeeded is safe here.
+//
+#define LOCK_SH     0x01
+#define LOCK_EX     0x02
+#define LOCK_NB     0x04
+#define LOCK_UN     0x08
+
+inline int fuse_flock(int fd, int operation)
+{
+    (void)fd;
+    (void)operation;
+    return 0;
+}
+
+//
+// mingw-w64's DIR has no file descriptor, so dirfd() hands out a dummy one and
+// fstatat() resolves the entry against the current directory instead of the
+// directory it belongs to.  That makes the "check all cache" debug output
+// report the entries it cannot stat; everything else uses full paths.
+//
+#define AT_FDCWD                (-100)
+#define AT_SYMLINK_NOFOLLOW     0x200
+
+inline int fuse_dirfd(DIR* dirp)
+{
+    return dirp ? 1 : -1;
+}
+
+inline int fuse_fstatat(int dirfd, const char* path, struct fuse_stat* stbuf, int flags)
+{
+    (void)dirfd;
+    (void)flags;
+    return fuse_stat(path, stbuf);
+}
+
+//
+// [NOTE]
+// _getdiskfree() works per drive, so a path that is not on the current drive
+// must carry its drive letter; that is why -o tmpdir= has to be absolute.
+//
+inline int fuse_statvfs(const char* path, struct fuse_statvfs* stbuf)
+{
+    unsigned int drive = 0;     // 0 = the current drive
+
+    if(path && '\0' != path[0] && ':' == path[1] &&
+       (('\0' != path[2] && ('/' == path[2] || '\\' == path[2])) || '\0' == path[2]) &&
+       (('A' <= path[0] && 'Z' >= path[0]) || ('a' <= path[0] && 'z' >= path[0])))
+    {
+        drive = static_cast<unsigned int>(path[0] - 'A' + 1);
+    }
+
+    struct _diskfree_t df = {};
+    if(0 != _getdiskfree(drive, &df)){
+        return -1;
+    }
+
+    *stbuf = {};
+    stbuf->f_frsize  = (df.bytes_per_sector ? df.bytes_per_sector : 512) * (df.sectors_per_cluster ? df.sectors_per_cluster : 1);
+    stbuf->f_bsize   = stbuf->f_frsize;
+    stbuf->f_blocks  = static_cast<fuse_fsblkcnt_t>(df.total_clusters);
+    stbuf->f_bfree   = static_cast<fuse_fsblkcnt_t>(df.avail_clusters);
+    stbuf->f_bavail  = static_cast<fuse_fsblkcnt_t>(df.avail_clusters);
+    stbuf->f_files   = 0;
+    stbuf->f_ffree   = 0;
+    stbuf->f_favail  = 0;
+    stbuf->f_namemax = 260;     // _MAX_PATH
+
+    return 0;
+}
+
+//
+// [NOTE]
+// The CRT can only set the access and the modification time, so the nanoseconds
+// and the ctime of the POSIX call are dropped; the cache file timestamps are
+// not used for cache validation, they are only informative.
+//
+inline int fuse_futimens(int fd, struct fuse_timespec times[2])
+{
+    struct __utimbuf64 ut = {};
+
+    if(!times){
+        return -1;
+    }
+    ut.actime  = times[0].tv_sec;
+    ut.modtime = times[1].tv_sec;
+
+    return _futime64(fd, &ut);
+}
+
+inline int fuse_utimensat(int dirfd, const char* path, const struct fuse_timespec times[2], int flags)
+{
+    struct __utimbuf64 ut = {};
+
+    (void)dirfd;
+    (void)flags;
+
+    if(!path){
+        return -1;
+    }
+    if(!times){
+        return -1;
+    }
+    ut.actime  = times[0].tv_sec;
+    ut.modtime = times[1].tv_sec;
+
+    return _wutime64(s3fs_utf8_to_wide(path).c_str(), &ut);
+}
+
+// The POSIX names of the stat timestamps(the CRT ones are read above).
+#define st_atime    st_atim.tv_sec
+#define st_mtime    st_mtim.tv_sec
+#define st_ctime    st_ctim.tv_sec
+
+//-------------------------------------------------------------------
+// POSIX functions the mingw-w64 headers do not declare
+//-------------------------------------------------------------------
+#define timegm      _mkgmtime
+
+inline struct tm* gmtime_r(const time_t* timer, struct tm* buf)
+{
+    return (0 == gmtime_s(buf, timer)) ? buf : nullptr;
+}
+
+inline struct tm* localtime_r(const time_t* timer, struct tm* buf)
+{
+    return (0 == localtime_s(buf, timer)) ? buf : nullptr;
+}
+
+//
+// [NOTE]
+// "struct timeval::tv_sec" is a long on mingw-w64, not a time_t, and
+// s3fs_logger.cpp hands it to gmtime_r().
+//
+inline struct tm* gmtime_r(const long* timer, struct tm* buf)
+{
+    const time_t sec = static_cast<time_t>(*timer);
+    return gmtime_r(&sec, buf);
+}
+
+inline struct tm* localtime_r(const long* timer, struct tm* buf)
+{
+    const time_t sec = static_cast<time_t>(*timer);
+    return localtime_r(&sec, buf);
+}
+
+//
+// clock_gettime() for the fuse_timespec that "struct timespec" now means: the
+// CRT only fills in its own structure.
+//
+inline int clock_gettime(int clk_id, struct fuse_timespec* tp)
+{
+    s3fs_crt_timespec crtnow;
+
+    int result = clock_gettime(clk_id, &crtnow);
+    if(0 == result && tp){
+        tp->tv_sec  = crtnow.tv_sec;
+        tp->tv_nsec = crtnow.tv_nsec;
+    }
+    return result;
+}
+
+inline int fsync(int fd)
+{
+    // _commit() is the CRT's name for flushing a file's buffers to the disk.
+    return _commit(fd);
+}
+
+//
+// A temporary file that is already "unlinked", the Unix way.
+//
+// FdManager::MakeTempFile() creates its scratch file with mkstemp() followed by
+// unlink(): the name disappears at once, the data stays readable and writable
+// through the descriptor, and nothing is left behind when the descriptor is
+// closed or the process dies.
+//
+// The Windows CRT cannot delete a file while a handle to it is open, so that
+// unlink() fails here with EACCES - which is what made every file open fail in
+// the r4 build("failed to delete tmp file. errno(13)").  _O_TEMPORARY is the
+// CRT's way of asking for FILE_FLAG_DELETE_ON_CLOSE, so the name goes away when
+// the last descriptor for the file is closed: the same observable behaviour,
+// including when the process is killed.
+//
+// s3fs_tempfile_unlinked() puts the open file `fd`, whose name is `path`, into
+// that state.  It returns the descriptor to use from then on - a new one, since
+// the file has to be reopened - or -1 with errno set, in which case `fd` has
+// been closed and `path` removed.
+//
+// [NOTE]
+// _O_TEMPORARY belongs to _sopen(), not to _open(), and it is the descriptor,
+// not the name, that owns the file: a dup()ed descriptor keeps the file alive
+// until it is closed too, exactly like on Unix.
+//
+inline int s3fs_tempfile_unlinked(int fd, const char* path)
+{
+    if(0 != _close(fd)){
+        return -1;
+    }
+    int newfd = _wsopen(s3fs_utf8_to_wide(path).c_str(), _O_RDWR | _O_BINARY | _O_TEMPORARY, _SH_DENYNO, _S_IREAD | _S_IWRITE);
+    if(-1 == newfd){
+        int saved_errno = errno;
+        unlink(path);                       // nothing can use the file any more
+        errno = saved_errno;
+        return -1;
+    }
+    return newfd;
+}
+
+inline long random(void)
+{
+    return static_cast<long>(rand());
+}
+
+//
+// [NOTE]
+// Not atomic: the CRT has no pread()/pwrite(), so the position is moved, the
+// transfer is done and the old position is put back.  Each handle is used by a
+// single thread in s3fs, which is what makes that safe here.
+//
+inline ssize_t pread(int fd, void* buf, size_t count, off_t offset)
+{
+    off_t   saved = _lseeki64(fd, 0, SEEK_CUR);
+    ssize_t result;
+
+    if(-1 == _lseeki64(fd, offset, SEEK_SET)){
+        return -1;
+    }
+    result = _read(fd, buf, count);
+    _lseeki64(fd, saved, SEEK_SET);
+
+    return result;
+}
+
+inline ssize_t pwrite(int fd, const void* buf, size_t count, off_t offset)
+{
+    off_t   saved = _lseeki64(fd, 0, SEEK_CUR);
+    ssize_t result;
+
+    if(-1 == _lseeki64(fd, offset, SEEK_SET)){
+        return -1;
+    }
+    result = _write(fd, buf, count);
+    _lseeki64(fd, saved, SEEK_SET);
+
+    return result;
+}
